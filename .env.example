# ============================================================
# JUE FISH AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# Anthropic API Key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Your Jue Fish product shop URL (update before launch)
NEXT_PUBLIC_SHOP_URL=https://your-store.com/products/stain-remover

# Optional: Your site URL (used for metadata / SEO)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
